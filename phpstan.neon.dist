includes:

parameters:
    level: 8
    phpVersion: 80200
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    checkOctaneCompatibility: true

    tmpDir: build/phpstan

    scanFiles:
        - stubs/livewire-component-registry.stub

    ignoreErrors:
        -
            identifier: property.onlyWritten
